# Firebase Configuration
# Create a Firebase project at https://console.firebase.google.com/
# Then copy your web app config values below.
# Rename this file to .env (or .env.local) and fill in your values.

# IndexNow (Bing)
# Generate a free key at https://www.bing.com/indexnow
# Then create client/public/<key>.txt containing just the key as plain text.
INDEXNOW_KEY=your_indexnow_key_here

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firestore Security Rules (add to Firebase console):
